# Server Configuration
APP_NAME="Edge TTS Service"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# TTS Configuration
MAX_TEXT_LENGTH=5000
AUDIO_OUTPUT_DIR="generated_audio"
LOG_DIR="logs"

# Cleanup Configuration
CLEAN_UP_INTERVAL_SECONDS=3600  # Check every hour
FILE_EXPIRATION_SECONDS=86400  # Delete files older than 24 hours
